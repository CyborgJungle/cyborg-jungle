---
import Base from '../layouts/Base.astro';
import TestPattern from '../components/TestPattern.astro';

// Replace the placeholder values with your own.
const profile: [string, string][] = [
  ['Operator', 'Cyborg Jungle'],
  ['Practice', 'Analog video art'],
  ['Based', '[Add your city]'],
  ['Active', '[Since year]'],
  ['Contact', '[Add email or link]'],
];

// The signal chain, in the order the image travels. Edit to match your setup.
const chain = [
  { n: '01', name: 'Source', detail: 'Camera · VHS deck' },
  { n: '02', name: 'Synthesis', detail: 'Video synthesizer · oscillators' },
  { n: '03', name: 'Mixing', detail: 'Keyer · video mixer' },
  { n: '04', name: 'Display', detail: 'CRT monitor · rescan' },
  { n: '05', name: 'Capture', detail: 'Camera · capture card' },
];
---

<Base title="About" description="About Cyborg Jungle, analog video artist." active="about">
  <section class="wrap">
    <div class="card panel">
      <span class="reg" style="top:-9px;right:-9px"></span>
      <div class="portrait crt">
        <TestPattern pattern="rings" seed="operator" label="Portrait placeholder" />
        <span class="frame" aria-hidden="true"></span>
      </div>
      <div class="info">
        <span class="label">Operator profile</span>
        <h1>Cyborg Jungle</h1>
        <dl>
          {profile.map(([k, v]) => (
            <div class="row"><dt class="label">{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
        <div class="bio">
          <p>[Replace with your bio.] Cyborg Jungle makes analog video art: images generated by video synthesizers, pushed through feedback loops and rescanned off cathode-ray tubes.</p>
          <p>[Add shows, collaborations and anything else you want visitors to know.]</p>
        </div>
      </div>
    </div>

    <section class="chain" aria-labelledby="chain-h">
      <h2 id="chain-h" class="label">Signal chain</h2>
      <div class="ruler"></div>
      <ol>
        {chain.map((s) => (
          <li>
            <span class="sn">{s.n}</span>
            <b>{s.name}</b>
            <span class="sd">{s.detail}</span>
          </li>
        ))}
      </ol>
    </section>
  </section>
</Base>

<style>
  .card {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: 40px;
    padding: 32px;
  }
  .portrait { aspect-ratio: 3 / 4; position: relative; }
  .portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(circle, rgb(4 6 12 / 0.6) 1px, transparent 1.5px) 0 0 / 5px 5px;
  }
  .frame {
    position: absolute;
    inset: 14%;
    z-index: 3;
    border: 1px solid var(--thermal);
  }
  .frame::before {
    content: 'SUBJECT_01XX';
    position: absolute;
    top: -19px;
    left: -1px;
    font-size: var(--step--2);
    background: var(--thermal);
    color: var(--void);
    padding: 0 6px;
    line-height: 18px;
  }
  .info { display: grid; gap: 16px; align-content: start; min-width: 0; }
  h1 { font-size: var(--step-4); text-shadow: -3px 0 rgb(255 0 80 / 0.45), 3px 0 rgb(0 220 255 / 0.45); }
  dl { margin: 0; }
  .row {
    display: grid;
    grid-template-columns: 12ch 1fr;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  dd { margin: 0; text-align: right; text-transform: uppercase; letter-spacing: 0.06em; color: var(--glow); min-width: 0; overflow-wrap: anywhere; }
  .bio p { max-width: 65ch; margin: 0 0 12px; }

  .chain { margin-top: 64px; }
  .chain h2 { font-family: var(--font-mono); font-weight: 400; }
  .chain ol {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 28px;
  }
  .chain li {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 16px;
    border: 1px solid var(--phosphor);
    background: rgb(61 123 255 / 0.06);
  }
  /* Trace to the next block */
  .chain li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -29px;
    width: 28px;
    height: 2px;
    background: var(--phosphor);
  }
  .chain li:not(:last-child)::before {
    content: '';
    position: absolute;
    top: calc(50% - 3px);
    right: -33px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--phosphor);
    z-index: 1;
  }
  .sn { font-family: var(--font-crt); font-size: var(--step-2); line-height: 1; color: var(--phosphor); }
  .chain b { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.08em; }
  .sd { color: var(--dim); font-size: var(--step--2); }

  @media (max-width: 900px) {
    .card { grid-template-columns: 1fr; padding: 20px; }
    .portrait { max-width: 320px; }
    .chain ol { grid-template-columns: 1fr; gap: 20px; }
    .chain li:not(:last-child)::after { top: auto; bottom: -21px; right: auto; left: 32px; width: 2px; height: 20px; }
    .chain li:not(:last-child)::before { top: auto; bottom: -25px; right: auto; left: 29px; }
  }
</style>
