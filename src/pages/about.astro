---
import Base from '../layouts/Base.astro';
import TestPattern from '../components/TestPattern.astro';
import Img from '../components/Img.astro';
import about from '../content/about.json';
import { resolveImage } from '../lib/media';

// Edited through Pages CMS (the "About page" entry), stored in src/content/about.json.
const profile = (
  [
    ['Practice', about.practice],
    ['Based in', about.based],
    ['Active since', about.active],
    ['Contact', about.contact],
  ] as [string, string | undefined][]
).filter((r): r is [string, string] => Boolean(r[1]?.trim()));
const portrait = resolveImage(about.portrait || undefined);
const photos = (about.photos ?? [])
  .filter((p) => p.image)
  .map((p) => ({ src: resolveImage(p.image)!, caption: p.caption }));
const bio = (about.bio ?? '').split(/\n\s*\n/).filter(Boolean);
const instagram = (about.instagram ?? '').replace(/^@/, '').trim();
// Messages go to this address through FormSubmit (formsubmit.co); see README "Contact form".
const CONTACT_EMAIL = 'cyborgjungle@gmail.com';
const formEndpoint = `https://formsubmit.co/${CONTACT_EMAIL}`;
---

<Base title="About" description="About Cyborg Jungle, analog video artist." active="about">
  <section class="wrap about" style={{ '--ch': 'var(--ch-about)' }}>
    <figure class="side">
      <div class="tv portrait">
        {portrait ? (
          <Img src={portrait} alt={`Portrait of ${about.name}`} widths={[480, 800]} sizes="(max-width: 899px) 100vw, 380px" loading="eager" />
        ) : (
          <TestPattern pattern="rings" seed="operator" label="Portrait placeholder" />
        )}
      </div>
      <div class="cap">
        {about.portraitCredit && <figcaption class="label">{about.portraitCredit}</figcaption>}
      </div>
    </figure>

    <div class="info">
      <div class="name">
        <h1 class="glitch-type">{about.name}</h1>
        <span class="jp tategaki" lang="ja">紹介</span>
      </div>
      <div class="bio">{bio.map((p) => <p>{p}</p>)}</div>
      {(profile.length > 0 || instagram) && (
        <dl class="spec">
          {profile.map(([k, v]) => (
            <div><dt class="label">{k}</dt><dd>{v}</dd></div>
          ))}
          {instagram && (
            <div><dt class="label">Instagram</dt><dd><a href={`https://www.instagram.com/${instagram}/`} rel="me noopener" target="_blank">@{instagram}</a></dd></div>
          )}
          <div><dt class="label">Contact</dt><dd><a href="#contact">Send a message</a></dd></div>
        </dl>
      )}
    </div>
  </section>

  {photos.length > 0 && (
    <section class="wrap live" aria-labelledby="live-h">
      <div class="section-head">
        <h2 id="live-h" class="glitch-type">Live <span lang="ja">ライブ</span></h2>
        <span class="label">{photos.length} photos</span>
      </div>
      <ul>
        {photos.map((p) => (
          <li>
            <figure>
              <div class="tv"><Img src={p.src} alt={p.caption || `${about.name} live`} widths={[480, 800]} sizes="(max-width: 639px) 100vw, (max-width: 999px) 50vw, 33vw" /></div>
              {p.caption && <figcaption>{p.caption}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )}
  <section class="wrap contact" id="contact" aria-labelledby="contact-h" style={{ '--ch': 'var(--ch-about)' }}>
    <div class="section-head">
      <h2 id="contact-h" class="glitch-type">Contact <span lang="ja">連絡</span></h2>
      {instagram && <a class="label" href={`https://www.instagram.com/${instagram}/`} rel="me noopener" target="_blank">@{instagram}</a>}
    </div>
    <form class="form" action={formEndpoint} method="POST" data-contact data-endpoint={`https://formsubmit.co/ajax/${CONTACT_EMAIL}`}>
      <input type="hidden" name="_subject" value="New message from cyborg-jungle.vercel.app" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_next" value="https://cyborg-jungle.vercel.app/about?sent=1#contact" />
      <!-- Spam trap: people never see or fill this field -->
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="honey" aria-hidden="true" />

      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />

      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" inputmode="email" required />

      <label for="cf-message">Message</label>
      <textarea id="cf-message" name="message" rows="6" required></textarea>

      <button type="submit">Send message</button>
      <p class="status" role="status" aria-live="polite" data-status></p>
    </form>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  if (new URLSearchParams(location.search).has('sent') && status) status.textContent = 'Message received. Thank you.';
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    const button = form.querySelector('button')!;
    button.disabled = true;
    status.dataset.state = '';
    status.textContent = 'Sending…';
    let data: { success?: string | boolean; message?: string } = {};
    try {
      const res = await fetch(form.dataset.endpoint!, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      data = await res.json();
    } catch {
      // The quick send failed (network, blocked request, unreadable reply): post the form the
      // ordinary way instead. FormSubmit delivers it and sends the visitor back here.
      HTMLFormElement.prototype.submit.call(form);
      return;
    }
    button.disabled = false;
    if (data.success === true || data.success === 'true') {
      form.reset();
      status.dataset.state = 'ok';
      status.textContent = 'Message received. Thank you.';
    } else if (/activat/i.test(data.message ?? '')) {
      // First use of the form: FormSubmit holds the message until the inbox owner confirms.
      status.dataset.state = 'ok';
      status.textContent = 'This form is being activated. The inbox owner has been sent a confirmation link; please try again shortly.';
    } else {
      status.dataset.state = 'error';
      status.textContent = data.message
        ? `The message could not be sent: ${data.message}`
        : 'The message could not be sent. Please try again, or write on Instagram @cyborgjungle.';
    }
  });
</script>

<style>
  .about { display: grid; gap: 24px; grid-template-columns: minmax(0, 1fr); }
  figure { margin: 0; }
  .side { display: grid; gap: 8px; align-content: start; }
  .portrait { aspect-ratio: 4 / 5; }
  .portrait > :global(img) { object-position: 75% 20%; }

  .info { display: grid; gap: 20px; align-content: start; min-width: 0; }
  .name { display: flex; align-items: start; justify-content: space-between; gap: 12px; }
  h1 { font-size: var(--step-3); }
  .jp { font-size: clamp(1.4rem, 6vw, 2.2rem); color: var(--ch-about); }
  .cap { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .section-head h2 span { font-size: 0.8em; color: var(--ch-about); text-shadow: none; }
  .bio p { margin: 0 0 14px; max-width: 60ch; font-size: var(--step-0); }
  .bio p:first-child { font-size: var(--step-1); line-height: 1.45; }

  .spec { margin: 0; border-top: var(--stroke) solid var(--rule); }
  .spec div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 12px; padding: 10px 0; border-bottom: var(--stroke) solid var(--rule); align-items: baseline; }
  .spec dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }

  .live { margin-top: 48px; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 10px; border-bottom: var(--stroke) solid var(--rule); }
  .section-head h2 { font-size: var(--step-2); }
  .live ul { list-style: none; margin: 24px 0 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 28px 20px; }
  .live .tv { aspect-ratio: 4 / 3; }
  .live figcaption { margin-top: 8px; font-size: var(--step--1); color: var(--cream-soft); }

  @media (min-width: 640px) { .live ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) {
    .about { grid-template-columns: 380px minmax(0, 1fr); gap: 48px; }
  }
  @media (min-width: 1000px) { .live ul { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .spec a { color: var(--cream); }
  .spec a:hover { color: var(--mint); }

  .contact { margin-top: 56px; scroll-margin-top: 24px; }
  .section-head a.label { text-decoration: none; color: var(--mint); padding: 8px 0; }
  .form { display: grid; gap: 8px; margin-top: 24px; max-width: 36rem; }
  .form label { font-family: var(--font-pixel); font-size: var(--step--1); color: var(--cream-soft); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 8px; }
  .form input, .form textarea {
    width: 100%;
    font: inherit;
    font-size: 16px; /* 16px keeps iOS from zooming into the field */
    color: var(--cream);
    background: var(--panel);
    border: var(--stroke) solid var(--rule);
    border-radius: 10px;
    padding: 12px 14px;
    min-height: 48px;
  }
  .form textarea { resize: vertical; min-height: 140px; }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--mint); }
  .form button {
    margin-top: 12px;
    justify-self: start;
    min-height: 48px;
    padding: 0 24px;
    font-family: var(--font-display);
    font-size: var(--step-0);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--void);
    background: var(--ch);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
  }
  .form button:disabled { opacity: 0.6; cursor: progress; }
  .honey { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .status { margin: 4px 0 0; min-height: 1.6em; font-family: var(--font-pixel); color: var(--cream-soft); }
  .status[data-state='ok'] { color: var(--mint); }
  .status[data-state='error'] { color: var(--red); }
</style>
