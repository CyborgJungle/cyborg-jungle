---
import Base from '../../layouts/Base.astro';
import TestPattern from '../../components/TestPattern.astro';
import Img from '../../components/Img.astro';
import Frames from '../../components/Frames.astro';
import { channelFor } from '../../data/channels';
import { resolvedWorks, type ResolvedWork } from '../../data/works';

export async function getStaticPaths() {
  const works = await resolvedWorks();
  return works.map((work) => {
    const siblings = works.filter((w) => w.kind === work.kind);
    const i = siblings.indexOf(work);
    return {
      params: { slug: work.slug },
      props: {
        work,
        position: i + 1,
        total: siblings.length,
        prev: siblings[(i - 1 + siblings.length) % siblings.length],
        next: siblings[(i + 1) % siblings.length],
      },
    };
  });
}

interface Props {
  work: ResolvedWork;
  position: number;
  total: number;
  prev: ResolvedWork;
  next: ResolvedWork;
}

const { work, position, total, prev, next } = Astro.props;
const ch = channelFor(work.kind);
const aspect =
  work.aspect ?? (work.image && typeof work.image !== 'string' ? `${work.image.width} / ${work.image.height}` : '4 / 3');
const [w, h] = aspect.split('/').map(Number);
// Cap the screen at 75% of the viewport height while keeping its shape.
const frameStyle = { aspectRatio: aspect, maxWidth: `min(100%, calc(75vh * ${w / h}))` };
const paragraphs = work.description?.split(/\n\s*\n/) ?? [];
const isShow = work.slideshow && work.frames.length > 1;
const pad2 = (n: number) => String(n).padStart(2, '0');
// Spec-sheet aspect: "4:3" for simple ratios, "1.78:1" otherwise.
const gcd = (a: number, b: number): number => (b ? gcd(b, a % b) : a);
const g = gcd(w, h);
const aspectLabel = w / g <= 32 && h / g <= 32 ? `${w / g}:${h / g}` : `${(w / h).toFixed(2)}:1`;

const rows = [
  ['Channel', `CH.${ch.num} ${ch.label}`],
  ['Year', String(work.year)],
  ['Medium', work.medium],
  ['Format', work.format],
  ['Duration', work.duration],
  ['Location', work.location],
  ['Aspect', aspectLabel],
].filter((r): r is [string, string] => Boolean(r[1]));
---

<Base title={work.title} description={paragraphs[0]} active={ch.id}>
  <article class="wrap viewer" style={{ '--ch': ch.color }}>
    <div class="stage" data-show-root={isShow ? '' : undefined}>
      <div class="crt screen" style={frameStyle}>
        {isShow ? (
          <Frames frames={work.frames} alt={work.title} interval={work.interval} widths={[800, 1400, 2000]} sizes="(max-width: 980px) 100vw, 70vw" fit="contain" eager />
        ) : work.embed ? (
          <iframe src={work.embed} title={work.title} allow="autoplay; fullscreen; picture-in-picture" />
        ) : work.image ? (
          <Img src={work.image} alt={work.title} widths={[800, 1400, 2000]} sizes="(max-width: 980px) 100vw, 70vw" loading="eager" />
        ) : (
          <TestPattern pattern={work.pattern} seed={work.slug} />
        )}
      </div>
      {isShow && (
        <div class="show-ui">
          <button type="button" data-show="prev" aria-label="Previous image">◄</button>
          <button type="button" data-show="toggle" aria-label="Pause slideshow" aria-pressed="false">❚❚</button>
          <button type="button" data-show="next" aria-label="Next image">►</button>
          <span class="count"><span class="label">Frame</span> <b data-show-count>01</b>/{pad2(work.frames.length)}</span>
          <span class="label rate">{work.interval} s / frame</span>
        </div>
        <ul class="gallery thumbs">
          {work.frames.map((src, i) => (
            <li>
              <button type="button" class="crt" data-show-goto={i} aria-label={`Show image ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}>
                <Img src={src} alt="" widths={[240]} sizes="120px" />
              </button>
            </li>
          ))}
        </ul>
      )}
      {!isShow && work.gallery.length > 0 && (
        <ul class="gallery">
          {work.gallery.map((src, i) => (
            <li class="crt"><Img src={src} alt={`${work.title}, view ${i + 1}`} widths={[400, 800]} sizes="(max-width: 640px) 50vw, 200px" /></li>
          ))}
        </ul>
      )}
    </div>

    <aside class="spec panel">
      <svg class="trace" viewBox="0 0 60 120" aria-hidden="true">
        <path d="M0 20H24V100H60" fill="none" stroke="currentColor" stroke-width="2" />
        <circle cx="0" cy="20" r="4" fill="currentColor" />
        <circle cx="24" cy="60" r="3" fill="currentColor" />
        <rect x="52" y="96" width="8" height="8" fill="currentColor" />
      </svg>
      <span class="label ch-label">CH.{ch.num} · {String(position).padStart(2, '0')}/{String(total).padStart(2, '0')}</span>
      <h1>{work.title}</h1>
      <dl>
        {rows.map(([k, v]) => (
          <div class="row">
            <dt class="label">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
      {paragraphs.length > 0 && <div class="desc">{paragraphs.map((p) => <p>{p}</p>)}</div>}
      <nav class="step" aria-label={`More on channel ${ch.num}`}>
        <a href={`/work/${prev.slug}`} data-step="prev"><span aria-hidden="true">◄</span> {prev.title}</a>
        <a href={`/work/${next.slug}`} data-step="next">{next.title} <span aria-hidden="true">►</span></a>
      </nav>
      <a class="back" href={ch.path}>All of CH.{ch.num} {ch.label}</a>
    </aside>
  </article>
</Base>

<style>
  .viewer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    gap: 56px;
    align-items: start;
  }
  .stage { min-width: 0; display: grid; gap: 16px; justify-items: center; }
  .screen { width: 100%; box-shadow: 0 0 60px color-mix(in srgb, var(--ch) 18%, transparent); }
  .screen > :global(img) { object-fit: contain; background: #000; }
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
  }
  .gallery .crt { aspect-ratio: 4 / 3; }

  .show-ui {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    font-variant-numeric: tabular-nums;
  }
  .show-ui button {
    font: inherit;
    font-size: var(--step--1);
    width: 40px;
    height: 32px;
    color: var(--ch);
    background: transparent;
    border: 1px solid var(--line);
    cursor: pointer;
  }
  .show-ui button:hover { border-color: var(--ch); }
  .count { margin-left: 8px; font-size: var(--step--1); }
  .count b { font-family: var(--font-crt); font-weight: 400; font-size: var(--step-1); color: var(--ch); }
  .rate { margin-left: auto; }
  .thumbs { grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 8px; }
  .thumbs button.crt {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 6;
    padding: 0;
    border: 0;
    cursor: pointer;
    opacity: 0.45;
    transition: opacity var(--snap);
  }
  .thumbs button > :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .thumbs button:hover, .thumbs button[aria-current] { opacity: 1; }
  .thumbs button[aria-current] { outline: 1px solid var(--ch); outline-offset: 2px; }

  .spec { padding: 24px; display: grid; gap: 16px; position: relative; }
  .trace {
    position: absolute;
    left: -58px;
    top: 24px;
    width: 60px;
    height: 120px;
    color: var(--ch);
  }
  .ch-label { color: var(--ch); }
  h1 { font-size: var(--step-3); color: var(--ink); text-shadow: -2px 0 rgb(255 0 80 / 0.45), 2px 0 rgb(0 220 255 / 0.45); }
  dl { margin: 0; display: grid; }
  .row {
    display: grid;
    grid-template-columns: 10ch 1fr;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  dd { margin: 0; font-size: var(--step--1); min-width: 0; }
  .desc p { margin: 0 0 10px; color: var(--ink); font-size: var(--step--1); max-width: 65ch; }
  .step {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .step a { border: 1px solid var(--line); padding: 10px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .step a:last-child { text-align: right; }
  .step a:hover { border-color: var(--ch); color: var(--ch); }
  .back { font-size: var(--step--2); text-transform: uppercase; letter-spacing: 0.1em; color: var(--dim); }
  .back:hover { color: var(--ch); }

  @media (max-width: 980px) {
    .viewer { grid-template-columns: 1fr; gap: 32px; }
    .trace { display: none; }
  }
</style>
