---
import Base from '../../layouts/Base.astro';
import { works, type Work } from '../../data/works';

export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

const { work } = Astro.props as { work: Work };
---

<Base title={work.title} description={work.description}>
  <article>
    <div class="media">
      {work.embed ? (
        <iframe src={work.embed} title={work.title} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen />
      ) : work.kind === 'video' && work.src ? (
        <video src={work.src} poster={work.thumb} controls playsinline preload="metadata" />
      ) : work.src ? (
        <img src={work.src} alt={work.title} />
      ) : (
        <div class="bars" />
      )}
    </div>
    <h1>{work.title}</h1>
    <p class="sub">{work.year}{work.medium && ` · ${work.medium}`}</p>
    {work.description && <p>{work.description}</p>}
    <p><a href="/">← All work</a></p>
  </article>
</Base>

<style>
  .media {
    aspect-ratio: 4 / 3;
    max-height: 80vh;
    margin: 0 auto;
    background: #000;
    border: 1px solid var(--line);
  }
  .media iframe, .media video, .media img {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    object-fit: contain;
  }
  h1 { margin: 24px 0 0; font-size: 1.4rem; letter-spacing: 0.05em; }
  .sub { color: var(--dim); margin-top: 4px; }
  article p { max-width: 65ch; }
</style>
