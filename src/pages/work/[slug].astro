---
import Base from '../../layouts/Base.astro';
import TestPattern from '../../components/TestPattern.astro';
import Img from '../../components/Img.astro';
import Frames from '../../components/Frames.astro';
import { channelFor } from '../../data/channels';
import { resolvedWorks, type ResolvedWork } from '../../data/works';

export async function getStaticPaths() {
  const works = await resolvedWorks();
  return works.map((work) => {
    const siblings = works.filter((w) => w.kind === work.kind);
    const i = siblings.indexOf(work);
    return {
      params: { slug: work.slug },
      props: {
        work,
        prev: siblings.length > 1 ? siblings[(i - 1 + siblings.length) % siblings.length] : undefined,
        next: siblings.length > 1 ? siblings[(i + 1) % siblings.length] : undefined,
      },
    };
  });
}

interface Props {
  work: ResolvedWork;
  prev?: ResolvedWork;
  next?: ResolvedWork;
}

const { work, prev, next } = Astro.props;
const ch = channelFor(work.kind);
const aspect =
  work.aspect ?? (work.image && typeof work.image !== 'string' ? `${work.image.width} / ${work.image.height}` : '4 / 3');
const [w, h] = aspect.split('/').map(Number);
// Cap the screen at 70% of the viewport height while keeping its shape.
const frameStyle = { aspectRatio: aspect, maxWidth: `min(100%, calc(70vh * ${w / h}))` };
const paragraphs = work.description?.split(/\n\s*\n/) ?? [];
const isShow = work.slideshow && work.frames.length > 1;
const alt = work.alt ?? work.title;
const total = work.frames.length;
const pad2 = (n: number) => String(n).padStart(2, '0');

// Print-style aspect label: "4:3" for simple ratios, "1.40:1" otherwise.
const gcd = (a: number, b: number): number => (b ? gcd(b, a % b) : a);
const g = gcd(w, h);
const aspectLabel = w / g <= 32 && h / g <= 32 ? `${w / g}:${h / g}` : `${(w / h).toFixed(2)}:1`;

const rows = [
  ['Year', String(work.year)],
  ['Medium', work.medium],
  ['Format', work.format],
  ['Duration', work.duration],
  ['Location', work.location],
  ['Aspect', aspectLabel],
].filter((r): r is [string, string] => Boolean(r[1]));
---

<Base title={work.title} description={paragraphs[0]} active={ch.id}>
  <article class="wrap work" style={{ '--ch': ch.color }}>
    <a class="back label" href={ch.path}>← {ch.label}</a>

    <header class="title-block">
      <div class="tt">
        <h1 class="glitch-type">{work.title}</h1>
        <p class="meta"><span class="dot" aria-hidden="true"></span>{ch.label} · {work.year}{total > 1 && ` · ${total} frames`}</p>
      </div>
      {work.kana && <span class="kana tategaki" lang="ja">{work.kana}</span>}
    </header>

    <div class="stage" data-show-root={isShow ? '' : undefined}>
      <div class="tv screen" style={frameStyle}>
        {isShow ? (
          <Frames frames={work.frames} alt={alt} interval={work.interval} widths={[640, 960, 1400]} sizes="(max-width: 999px) 100vw, 60vw" fit="contain" eager />
        ) : work.embed ? (
          <iframe src={work.embed} title={work.title} allow="autoplay; fullscreen; picture-in-picture" />
        ) : work.image ? (
          <Img src={work.image} alt={alt} widths={[640, 960, 1400]} sizes="(max-width: 999px) 100vw, 60vw" loading="eager" />
        ) : (
          <TestPattern pattern={work.pattern} seed={work.slug} />
        )}
      </div>
      <div class="dim" aria-hidden="true"><span></span><b>{aspectLabel}</b><span></span></div>

      {isShow && (
        <>
          <div class="controls">
            <button type="button" data-show="prev" aria-label="Previous frame">←</button>
            <button type="button" data-show="toggle" aria-label="Pause slideshow" aria-pressed="false">❚❚</button>
            <button type="button" data-show="next" aria-label="Next frame">→</button>
            <span class="count"><b data-show-count>01</b> / {pad2(total)}</span>
          </div>
          <ul class="thumbs" aria-label="All frames">
            {work.frames.map((src, i) => (
              <li>
                <button type="button" data-show-goto={i} aria-label={`Show frame ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}>
                  <Img src={src} alt="" widths={[200]} sizes="96px" />
                </button>
              </li>
            ))}
          </ul>
        </>
      )}

      {!isShow && work.gallery.length > 0 && (
        <ul class="gallery">
          {work.gallery.map((src, i) => (
            <li class="tv"><Img src={src} alt={`${work.title}, view ${i + 1}`} widths={[480, 800]} sizes="(max-width: 639px) 100vw, 33vw" /></li>
          ))}
        </ul>
      )}
    </div>

    <div class="text">
      {paragraphs.length > 0 && <div class="desc">{paragraphs.map((p) => <p>{p}</p>)}</div>}

      <dl class="spec">
        {rows.map(([k, v]) => (
          <div>
            <dt class="label">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>

      {work.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {work.tags.map((t) => (
            <li><a class="stamp" href={`${ch.path}?tag=${encodeURIComponent(t)}`}>{t}</a></li>
          ))}
        </ul>
      )}
    </div>

    {prev && next && (
      <nav class="step" aria-label={`More ${ch.label.toLowerCase()}`}>
        <a href={`/work/${prev.slug}`} data-step="prev"><span class="label">← Previous</span><span class="t">{prev.title}</span></a>
        <a href={`/work/${next.slug}`} data-step="next"><span class="label">Next →</span><span class="t">{next.title}</span></a>
      </nav>
    )}
  </article>
</Base>

<style>
  .work {
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'back' 'title' 'stage' 'text' 'step';
  }
  .back { grid-area: back; color: var(--mint); text-decoration: none; justify-self: start; padding: 8px 0; }
  .title-block { grid-area: title; }
  .stage { grid-area: stage; min-width: 0; display: grid; gap: 12px; }
  .text { grid-area: text; min-width: 0; display: grid; gap: 20px; align-content: start; }
  .step { grid-area: step; }

  .title-block { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: 14px; }
  .tt { min-width: 0; }
  h1 { font-size: var(--step-3); overflow-wrap: anywhere; }
  .kana { font-size: clamp(1.2rem, 5vw, 1.6rem); color: var(--ch); }
  .meta { display: flex; align-items: center; gap: 8px; margin: 8px 0 0; color: var(--cream-soft); font-size: var(--step--1); font-family: var(--font-pixel); }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--ch); }

  .screen { width: 100%; justify-self: center; }
  .screen > :global(img) { object-fit: contain; }

  /* Dimension line, as on printed packaging */
  .dim { display: flex; align-items: center; gap: 10px; font-size: var(--step--2); }
  .dim span { flex: 1; height: var(--stroke); background: var(--cream); position: relative; }
  .dim span:first-child::before, .dim span:last-child::after {
    content: '';
    position: absolute;
    top: -4px;
    border: 4.5px solid transparent;
  }
  .dim span:first-child::before { left: -2px; border-right-color: var(--cream); border-left-width: 0; }
  .dim span:last-child::after { right: -2px; border-left-color: var(--cream); border-right-width: 0; }
  .dim b { font-weight: 700; letter-spacing: 0.06em; }

  .controls { display: flex; align-items: center; gap: 8px; }
  .controls button {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: var(--stroke) solid var(--cream);
    background: var(--void);
    color: var(--cream);
    font: inherit;
    font-size: var(--step-0);
    cursor: pointer;
  }
  .controls button[data-show='toggle'] { background: var(--ch); border-color: var(--ch); color: var(--void); }
  .count { margin-left: auto; font-variant-numeric: tabular-nums; color: var(--cream-soft); }
  .count b { font-family: var(--font-display); font-weight: 400; font-size: var(--step-1); color: var(--cream); }
  .count { font-family: var(--font-pixel); }

  /* Thumbnail strip: swipe sideways on phones */
  .thumbs {
    list-style: none;
    margin: 0 calc(-1 * var(--gutter));
    padding: 4px var(--gutter) 8px;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }
  .thumbs::-webkit-scrollbar { display: none; }
  .thumbs li { flex: none; scroll-snap-align: start; }
  .thumbs button {
    display: block;
    width: 72px;
    aspect-ratio: 1;
    padding: 0;
    border: 3px solid transparent;
    border-radius: 10px;
    overflow: hidden;
    background: var(--panel);
    cursor: pointer;
    opacity: 0.5;
  }
  .thumbs button > :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .thumbs button[aria-current] { opacity: 1; border-color: var(--ch); }

  .gallery { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 12px; }
  .gallery .tv { aspect-ratio: 4 / 3; }

  .desc p { margin: 0 0 12px; max-width: 62ch; }
  .spec { margin: 0; border-top: var(--stroke) solid var(--rule); }
  .spec div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 12px;
    padding: 10px 0;
    border-bottom: var(--stroke) solid var(--rule);
    align-items: baseline;
  }
  .spec dd { margin: 0; min-width: 0; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags .stamp:hover { background: var(--ch); border-color: var(--ch); color: var(--void); }

  .step { display: grid; grid-template-columns: 1fr 1fr; border-top: var(--stroke) solid var(--rule); margin-top: 12px; }
  .step a { display: grid; gap: 4px; padding: 16px 12px 16px 0; text-decoration: none; min-width: 0; }
  .step a + a { text-align: right; padding: 16px 0 16px 12px; border-left: var(--stroke) solid var(--rule); }
  .step .t { font-family: var(--font-display); text-transform: uppercase; font-size: var(--step-1); line-height: 1.05; overflow-wrap: anywhere; }
  .step a:hover .t { color: var(--ch); }

  @media (min-width: 1000px) {
    .work {
      grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr);
      grid-template-areas: 'back back' 'stage title' 'stage text' 'step step';
      grid-template-rows: auto auto 1fr auto;
      column-gap: 48px;
    }
    .thumbs { margin: 0; padding: 4px 0 8px; flex-wrap: wrap; overflow: visible; }
    .thumbs button { width: 64px; }
  }
</style>
