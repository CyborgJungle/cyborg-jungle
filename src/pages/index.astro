---
import Base from '../layouts/Base.astro';
import WorkTile from '../components/WorkTile.astro';
import { channels } from '../data/channels';
import { resolvedWorks } from '../data/works';

const all = await resolvedWorks();
const count = (id: string) => all.filter((w) => w.kind === id).length;
---

<Base>
  <section class="wrap hero">
    <span class="reg" style="top:-9px;left:calc(var(--gutter) - 9px)"></span>
    <span class="reg" style="top:-9px;right:calc(var(--gutter) - 9px)"></span>
    <div class="hero-in">
      <div class="id">
        <span class="label">Analog video art</span>
        <h1 class="wordmark" data-text="CYBORG JUNGLE">Cyborg<br />Jungle</h1>
        <p class="spec">Video fed through a chain of analog mixers and effect modules onto a CRT, then filmed straight off the screen. The whole workflow is analog. Images, video and interactive installations.</p>
      </div>
      <nav class="tuner" aria-label="Channels">
        {channels.map((c) => (
          <a href={c.path} style={{ '--ch': c.color }}>
            <span class="n">{c.num}</span>
            <span class="t">{c.label}</span>
            <span class="dots" aria-hidden="true"></span>
            <span class="c">{c.id === 'about' ? 'INFO' : `${String(count(c.id)).padStart(2, '0')} SIG`}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="wrap wall-wrap" aria-labelledby="wall-h">
    <div class="wall-head">
      <h2 id="wall-h" class="label">Monitor wall</h2>
      <span class="label">All channels</span>
    </div>
    <div class="ruler"></div>
    <div class="wall">
      {all.map((w, i) => <WorkTile work={w} index={i} size={i === 0 ? 'big' : 'normal'} />)}
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; padding-block: 24px 56px; }
  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 48px;
    align-items: end;
  }
  .wordmark {
    position: relative;
    font-size: clamp(3.2rem, 12vw, 10rem);
    line-height: 0.86;
    letter-spacing: 0.02em;
    margin-top: 12px;
    text-shadow: -4px 0 rgb(255 0 80 / 0.5), 4px 0 rgb(0 220 255 / 0.5);
    animation: wobble 6s steps(1) infinite;
  }
  .spec { color: var(--dim); max-width: 46ch; margin: 20px 0 0; }

  .tuner { display: grid; border-top: 1px solid var(--line); }
  .tuner a {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: baseline;
    gap: 14px;
    padding: 14px 4px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .n { font-family: var(--font-crt); font-size: var(--step-2); line-height: 1; color: var(--ch); }
  .t { font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); }
  .dots { border-bottom: 1px dotted var(--line); align-self: center; }
  .c { color: var(--dim); font-size: var(--step--2); font-variant-numeric: tabular-nums; }
  .tuner a { border-left: 2px solid transparent; transition: background var(--snap), border-color var(--snap); }
  .tuner a:hover { background: color-mix(in srgb, var(--ch) 10%, transparent); border-left-color: var(--ch); }
  .tuner a:hover .n { text-shadow: 0 0 12px var(--ch); }
  .tuner a:hover .t { color: var(--ch); }

  .wall-head { display: flex; justify-content: space-between; }
  .wall-head h2 { font-family: var(--font-mono); font-weight: 400; }
  .wall {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 40px 24px;
  }
  @media (max-width: 1100px) { .wall { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 820px) {
    .hero-in { grid-template-columns: 1fr; gap: 32px; }
    .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) { .wall { grid-template-columns: 1fr; } }

  @keyframes wobble {
    0%, 92%, 100% { transform: none; }
    93% { transform: translateX(-6px) skewX(-4deg); }
    95% { transform: translateX(4px); }
    97% { transform: translateX(-2px) skewX(2deg); }
  }
</style>
