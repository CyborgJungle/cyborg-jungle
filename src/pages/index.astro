---
import Base from '../layouts/Base.astro';
import WorkTile from '../components/WorkTile.astro';
import Wordmark from '../components/Wordmark.astro';
import Img from '../components/Img.astro';
import { resolvedWorks } from '../data/works';
import { resolveImage } from '../lib/media';
import home from '../content/home.json';

const all = await resolvedWorks();

// The hero is chosen in Pages CMS ("Home page" → Hero image). It links to the work it belongs to.
const heroSrc = resolveImage(home.heroImage) ?? all[0]?.thumb;
const heroWork = all.find((w) => w.image && [w.image, ...w.gallery].some((f) => f === heroSrc)) ?? all[0];
const heroAlt = heroWork?.alt ?? 'Analog video still by Cyborg Jungle';
const sizes = '(max-width: 999px) 100vw, 1100px';
---

<Base>
  <section class="wrap hero">
    {heroSrc && (
      <a class="hero-link" href={heroWork ? `/work/${heroWork.slug}` : '/image'}>
        <div class="tv hero-screen">
          <Img src={heroSrc} alt={heroAlt} widths={[640, 960, 1400]} sizes={sizes} loading="eager" />
          <Img src={heroSrc} alt="" widths={[640, 960, 1400]} sizes={sizes} loading="eager" class="slice s1" />
          <Img src={heroSrc} alt="" widths={[640, 960, 1400]} sizes={sizes} loading="eager" class="slice s2" />
        </div>
        {heroWork && (
          <>
            <span class="hero-kana tategaki" lang="ja" aria-hidden="true">{heroWork.kana ?? 'サイボーグ'}</span>
            <span class="hero-tag">
              <span class="label">Now showing</span><b>{heroWork.title}</b>
            </span>
          </>
        )}
      </a>
    )}
  </section>

  <section class="wrap intro">
    <Wordmark size="large" tag="h1" kana />
    <p>Analog video art. Video fed through a chain of mixers and effect modules onto a CRT, then filmed straight off the screen.</p>
  </section>

  <section class="wrap" aria-labelledby="works-h">
    <div class="section-head">
      <h2 id="works-h" class="glitch-type">Work <span lang="ja">作品</span></h2>
      <span class="label">{all.length} projects</span>
    </div>
    <div class="grid">
      {all.map((w) => <WorkTile work={w} still />)}
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 4px; }
  .hero-link { position: relative; display: block; text-decoration: none; color: var(--cream); }
  .hero-screen { aspect-ratio: 4 / 5; border-width: 6px; }
  @media (min-width: 700px) { .hero-screen { aspect-ratio: 16 / 9; } }

  /* Periodic signal failure: two slices of the picture slip sideways and split into colour */
  .hero-screen :global(.slice) { opacity: 0; animation: burst 6s steps(1) infinite; }
  .hero-screen :global(.s1) { clip-path: inset(28% 0 58% 0); }
  .hero-screen :global(.s2) { clip-path: inset(63% 0 24% 0); animation-delay: 0.15s; }
  @keyframes burst {
    0%, 86%, 100% { opacity: 0; transform: none; filter: none; }
    87% { opacity: 1; transform: translateX(-18px); filter: url(#rgb-split); }
    89% { opacity: 1; transform: translateX(12px); filter: url(#rgb-split); }
    91% { opacity: 1; transform: translateX(-6px); filter: none; }
    93% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-screen :global(.slice) { display: none; } }

  .hero-kana {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 4;
    font-size: clamp(1.1rem, 5vw, 1.8rem);
    color: var(--cream);
    background: var(--void);
    padding: 10px 6px;
  }
  .hero-tag {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 4;
    display: grid;
    gap: 2px;
    padding: 8px 14px 8px 12px;
    background: var(--void);
    border-left: 3px solid var(--red);
  }
  .hero-tag b { font-family: var(--font-display); font-weight: 400; text-transform: uppercase; font-size: var(--step-1); line-height: 1.05; }
  .hero-tag .label { font-size: var(--step--2); color: var(--mint); }

  .intro { display: grid; gap: 16px; padding-block: 36px 40px; }
  .intro p { margin: 0; max-width: 36rem; color: var(--cream-soft); }

  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 12px; border-bottom: var(--stroke) solid var(--rule); }
  .section-head h2 { font-size: var(--step-2); }
  .section-head h2 span { font-size: 0.8em; color: var(--red); text-shadow: none; }

  .grid { margin-top: 24px; display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; } }
</style>
