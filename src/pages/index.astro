---
import Base from '../layouts/Base.astro';
import WorkTile from '../components/WorkTile.astro';
import Wordmark from '../components/Wordmark.astro';
import DotRing from '../components/DotRing.astro';
import { resolvedWorks } from '../data/works';

const all = await resolvedWorks();
---

<Base home>
  <section class="wrap hero">
    <Wordmark size="large" tag="h1" />
    <div class="intro">
      <DotRing size="72px" />
      <p>Analog video art. Video fed through a chain of mixers and effect modules onto a CRT, then filmed straight off the screen.</p>
    </div>
  </section>

  <section class="wrap" aria-labelledby="works-h">
    <div class="section-head">
      <h2 id="works-h">Work</h2>
      <span class="label">{all.length} projects</span>
    </div>
    <hr class="rule" />
    <div class="grid">
      {all.map((w, i) => <WorkTile work={w} size={i === 0 ? 'big' : 'normal'} />)}
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; gap: 20px; padding-block: 8px 40px; }
  .intro { display: flex; align-items: center; gap: 16px; max-width: 34rem; }
  .intro p { margin: 0; font-size: var(--step-0); }

  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 10px; }
  .section-head h2 { font-size: var(--step-2); }

  .grid {
    margin-top: 24px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px 20px;
  }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-flow: dense; gap: 40px 24px; }
    .hero { grid-template-columns: 1fr auto; align-items: end; }
  }
</style>
