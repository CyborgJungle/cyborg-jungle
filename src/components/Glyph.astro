---
// A constructed, kanji-like glyph: two or three "radicals" built from thick strokes, arcs and dots,
// laid out the way kanji split into parts (left/right, top/bottom). Deterministic per seed, so a
// project or channel always has the same mark. Strokes take currentColor; dots take --accent.
interface Props {
  seed: string;
  size?: string;
  /** CSS colour for the dots (defaults to the signal red). */
  accent?: string;
  label?: string;
  glitch?: boolean;
}

const { seed, size = '64px', accent = 'var(--red)', label, glitch = false } = Astro.props;

let h = 2166136261;
for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
const rand = () => ((h = Math.imul(h ^ (h >>> 15), 2246822507) ^ Math.imul(h ^ (h >>> 13), 3266489909)) >>> 0) / 4294967296;
const pick = <T,>(xs: T[]) => xs[Math.floor(rand() * xs.length)];

const S = 12; // stroke width
type Box = { x: number; y: number; w: number; h: number };
type Part = { d: string; dots: [number, number, number][] };

// Inset by half a stroke so strokes stay inside their box.
const inner = (b: Box): Box => ({ x: b.x + S / 2, y: b.y + S / 2, w: b.w - S, h: b.h - S });

const radicals: Record<string, (b: Box) => Part> = {
  bars: (o) => {
    const b = inner(o);
    const n = o.h > o.w * 0.9 ? 3 : 2;
    let d = '';
    for (let i = 0; i < n; i++) d += `M${b.x} ${b.y + (i * b.h) / (n - 1)}H${b.x + b.w}`;
    return { d, dots: [] };
  },
  comb: (o) => {
    const b = inner(o);
    return { d: `M${b.x} ${b.y}V${b.y + b.h}M${b.x} ${b.y}H${b.x + b.w}M${b.x} ${b.y + b.h / 2}H${b.x + b.w * 0.75}M${b.x} ${b.y + b.h}H${b.x + b.w}`, dots: [] };
  },
  box: (o) => {
    const b = inner(o);
    return { d: `M${b.x} ${b.y}H${b.x + b.w}V${b.y + b.h}H${b.x}Z`, dots: [[b.x + b.w / 2, b.y + b.h / 2, Math.min(b.w, b.h) * 0.22]] };
  },
  sun: (o) => {
    const b = inner(o);
    return { d: `M${b.x} ${b.y}H${b.x + b.w}V${b.y + b.h}H${b.x}ZM${b.x} ${b.y + b.h / 2}H${b.x + b.w}`, dots: [] };
  },
  gate: (o) => {
    const b = inner(o);
    return { d: `M${b.x} ${b.y + b.h}V${b.y}H${b.x + b.w}V${b.y + b.h}`, dots: [[b.x + b.w / 2, b.y + b.h * 0.62, Math.min(b.w, b.h) * 0.16]] };
  },
  hook: (o) => {
    const b = inner(o);
    const r = Math.min(b.w, b.h) * 0.45;
    return { d: `M${b.x} ${b.y}V${b.y + b.h - r}A${r} ${r} 0 0 0 ${b.x + r} ${b.y + b.h}H${b.x + b.w}`, dots: [] };
  },
  arch: (o) => {
    const b = inner(o);
    const r = b.w / 2;
    return { d: `M${b.x} ${b.y + b.h}V${b.y + Math.min(r, b.h)}A${r} ${r} 0 0 1 ${b.x + b.w} ${b.y + Math.min(r, b.h)}V${b.y + b.h}`, dots: [] };
  },
  ring: (o) => {
    const b = inner(o);
    const r = Math.min(b.w, b.h) / 2;
    const cx = b.x + b.w / 2, cy = b.y + b.h / 2;
    return { d: `M${cx - r} ${cy}A${r} ${r} 0 1 0 ${cx + r} ${cy}A${r} ${r} 0 1 0 ${cx - r} ${cy}`, dots: [[cx, cy, r * 0.42]] };
  },
  dots: (o) => {
    const vertical = o.h >= o.w;
    const n = 3;
    const r = Math.min(vertical ? o.w : o.h, (vertical ? o.h : o.w) / n) * 0.36;
    const pts: [number, number, number][] = [];
    for (let i = 0; i < n; i++) {
      const t = (i + 0.5) / n;
      pts.push(vertical ? [o.x + o.w / 2, o.y + o.h * t, r] : [o.x + o.w * t, o.y + o.h / 2, r]);
    }
    return { d: '', dots: pts };
  },
  cross: (o) => {
    const b = inner(o);
    return { d: `M${b.x + b.w / 2} ${b.y}V${b.y + b.h}M${b.x} ${b.y + b.h * 0.4}H${b.x + b.w}`, dots: [] };
  },
  sweep: (o) => {
    const b = inner(o);
    return { d: `M${b.x + b.w} ${b.y}A${b.w} ${b.h} 0 0 0 ${b.x} ${b.y + b.h}M${b.x + b.w} ${b.y + b.h * 0.45}V${b.y + b.h}`, dots: [] };
  },
  stair: (o) => {
    const b = inner(o);
    return { d: `M${b.x} ${b.y}H${b.x + b.w / 2}V${b.y + b.h / 2}H${b.x + b.w}V${b.y + b.h}`, dots: [] };
  },
  spiral: (o) => {
    const b = inner(o);
    const r1 = Math.min(b.w, b.h) / 2, r2 = r1 * 0.45;
    const cx = b.x + b.w / 2, cy = b.y + b.h / 2;
    return { d: `M${cx - r1} ${cy}A${r1} ${r1} 0 0 1 ${cx + r1} ${cy}V${b.y + b.h}M${cx - r2} ${cy}A${r2} ${r2} 0 0 1 ${cx + r2} ${cy}V${b.y + b.h}`, dots: [] };
  },
};

const G = 6; // gap between radicals
const layouts: ((pad: number) => Box[])[] = [
  // left | right
  (p) => [{ x: p, y: p, w: 34, h: 100 - 2 * p }, { x: p + 34 + G, y: p, w: 100 - 2 * p - 34 - G, h: 100 - 2 * p }],
  // top / bottom
  (p) => [{ x: p, y: p, w: 100 - 2 * p, h: 32 }, { x: p, y: p + 32 + G, w: 100 - 2 * p, h: 100 - 2 * p - 32 - G }],
  // left | (top / bottom)
  (p) => [
    { x: p, y: p, w: 32, h: 100 - 2 * p },
    { x: p + 32 + G, y: p, w: 100 - 2 * p - 32 - G, h: 40 },
    { x: p + 32 + G, y: p + 40 + G, w: 100 - 2 * p - 32 - G, h: 100 - 2 * p - 40 - G },
  ],
  // (left | right) / bottom
  (p) => [
    { x: p, y: p, w: 40, h: 46 },
    { x: p + 40 + G, y: p, w: 100 - 2 * p - 40 - G, h: 46 },
    { x: p, y: p + 46 + G, w: 100 - 2 * p, h: 100 - 2 * p - 46 - G },
  ],
];

const boxes = pick(layouts)(4);
// Large areas get structural radicals so the glyph reads dense and heavy; narrow ones get light marks.
const heavy = ['box', 'sun', 'gate', 'comb', 'bars', 'arch', 'spiral', 'stair', 'hook'];
const light = ['dots', 'ring', 'cross', 'sweep', 'bars', 'hook', 'box'];
const chosen: string[] = [];
for (const b of boxes) {
  const names = b.w * b.h > 2400 ? heavy : light;
  let n = pick(names);
  while (chosen.includes(n)) n = pick(names);
  chosen.push(n);
}
const parts = boxes.map((b, i) => radicals[chosen[i]](b));
// Every glyph carries at least one dot, like the red dots in the reference lettering.
if (!parts.some((p) => p.dots.length)) {
  const i = Math.floor(rand() * parts.length);
  const big = boxes[i].w * boxes[i].h > 2400;
  parts[i] = radicals[pick(big ? ['box', 'gate', 'ring'] : ['dots', 'ring'])](boxes[i]);
}
const path = parts.map((p) => p.d).join('');
const dots = parts.flatMap((p) => p.dots);
---

<svg
  class:list={['glyph', { glitch }]}
  viewBox="0 0 100 100"
  style={{ width: size, height: size, '--accent': accent }}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path d={path} fill="none" stroke="currentColor" stroke-width={S} stroke-linejoin="miter" />
  {dots.map(([x, y, r]) => <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r={r.toFixed(1)} />)}
</svg>

<style>
  .glyph { display: block; flex: none; color: var(--cream); overflow: visible; }
  circle { fill: var(--accent); }
  .glitch { filter: drop-shadow(-2px 0 var(--glitch-a)) drop-shadow(2px 0 var(--glitch-b)); }
</style>
