---
// A work as a black poster card: the screen, the title in vertical katakana and the English title.
// Colour only on the card's edge, the bar beside the title and the katakana.
import TestPattern from './TestPattern.astro';
import Img from './Img.astro';
import Frames from './Frames.astro';
import { channelFor } from '../data/channels';
import { POSTERS, type ResolvedWork } from '../data/works';

interface Props {
  work: ResolvedWork;
  /** Show one still image instead of the slideshow (the home page). */
  still?: boolean;
}

const { work, still = false } = Astro.props;
const ch = channelFor(work.kind);
const sizes = '(max-width: 639px) 90vw, (max-width: 999px) 45vw, 30vw';
const frameCount = work.frames.length;
// The card's slideshow starts on the series' preview frame
const fromCover = [...work.frames.slice(work.coverIndex), ...work.frames.slice(0, work.coverIndex)];
---

<a href={`/work/${work.slug}`} class="card" data-tile style={{ '--edge': POSTERS[work.poster] }}>
  <span class="tv screen">
    {!still && work.slideshow && frameCount > 1 ? (
      <Frames frames={fromCover} alt="" interval={work.interval} widths={[480, 800]} sizes={sizes} max={10} />
    ) : work.thumb ? (
      <Img src={work.thumb} alt="" widths={[480, 800]} sizes={sizes} />
    ) : (
      <TestPattern pattern={work.pattern} seed={work.slug} />
    )}
  </span>
  {work.kana && <span class="kana tategaki" lang="ja" aria-hidden="true">{work.kana}</span>}
  <span class="foot">
    <span class="title">{work.title}</span>
    <span class="meta">{ch.label} · {work.year}{frameCount > 1 && ` · ${frameCount} frames`}</span>
  </span>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'screen kana' 'foot kana';
    gap: 10px;
    padding: 10px;
    background: var(--panel);
    border: 2px solid var(--edge);
    color: var(--cream);
    text-decoration: none;
    min-width: 0;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .screen { grid-area: screen; aspect-ratio: 4 / 3; border-color: var(--void); }
  /* Pixel katakana, as under the logo in the footer */
  .kana { grid-area: kana; font-family: var(--font-pixel); font-size: 1rem; letter-spacing: 0.12em; color: var(--edge); align-self: start; max-height: 100%; overflow: hidden; }

  /* Compact caption: a short bar in the card colour, then title and meta */
  .foot { grid-area: foot; display: grid; gap: 1px; padding-left: 10px; border-left: 3px solid var(--edge); min-width: 0; }
  .title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .meta { font-family: var(--font-pixel); font-size: var(--step--2); color: var(--cream-soft); }

  /* Lift onto an offset block in the card colour; the picture misregisters */
  .card:hover, .card:focus-visible { transform: translate(-4px, -4px); box-shadow: 4px 4px 0 var(--edge); outline: none; }
  .card:hover .screen :global(img), .card:focus-visible .screen :global(img) { filter: url(#rgb-split); animation: jolt 0.3s steps(3) 1; }
  @keyframes jolt {
    0% { transform: translateX(0); }
    33% { transform: translateX(-6px); }
    66% { transform: translateX(4px); }
    100% { transform: translateX(0); }
  }
</style>
