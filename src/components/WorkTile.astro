---
import TestPattern from './TestPattern.astro';
import Img from './Img.astro';
import Frames from './Frames.astro';
import { channelFor } from '../data/channels';
import type { ResolvedWork } from '../data/works';

interface Props {
  work: ResolvedWork;
  size?: 'normal' | 'big';
}

const { work, size = 'normal' } = Astro.props;
const ch = channelFor(work.kind);
const sizes = size === 'big' ? '(max-width: 999px) 100vw, 66vw' : '(max-width: 639px) 100vw, (max-width: 999px) 50vw, 33vw';
const frameCount = work.frames.length;
---

<a href={`/work/${work.slug}`} class:list={['tile', size]} data-tile data-tags={work.tags.join('|')} style={{ '--ch': ch.color }}>
  <span class="tv screen">
    {work.slideshow && frameCount > 1 ? (
      <Frames frames={work.frames} alt="" interval={work.interval} widths={[480, 800, 1200]} sizes={sizes} max={10} />
    ) : work.thumb ? (
      <Img src={work.thumb} alt="" widths={[480, 800, 1200]} sizes={sizes} />
    ) : (
      <TestPattern pattern={work.pattern} seed={work.slug} />
    )}
  </span>
  <span class="cap">
    <span class="title">{work.title}</span>
    <span class="meta">
      <span class="dot" aria-hidden="true"></span>
      {ch.label} · {work.year}{frameCount > 1 && ` · ${frameCount} frames`}
    </span>
  </span>
</a>

<style>
  .tile {
    display: grid;
    gap: 10px;
    align-content: start;
    min-width: 0;
    text-decoration: none;
    color: var(--ink);
  }
  .screen { aspect-ratio: 4 / 3; transition: border-color 0.15s; }
  .tile:hover .screen, .tile:focus-visible .screen { border-color: var(--ch); }
  .tile:focus-visible { outline: none; }

  .cap { display: grid; gap: 2px; padding-inline: 2px; }
  .title { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.05; text-transform: uppercase; }
  .meta { display: flex; align-items: center; gap: 8px; font-size: var(--step--1); color: var(--ink-soft); }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--ch); flex: none; }

  /* Lead tile: two columns wide and two rows tall where the grid has three columns */
  @media (min-width: 1000px) {
    .big { grid-column: span 2; grid-row: span 2; grid-template-rows: 1fr auto; align-content: stretch; }
    .big .screen { aspect-ratio: auto; height: 100%; }
    .big .title { font-size: var(--step-2); }
  }
</style>
