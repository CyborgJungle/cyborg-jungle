---
// CYB●RG JUNGLE — the O is the red signal dot (power light / record light).
interface Props {
  size?: 'small' | 'large';
  tag?: 'span' | 'h1';
}

const { size = 'small', tag: Tag = 'span' } = Astro.props;
---

<Tag class:list={['wordmark', size]} aria-label="Cyborg Jungle">
  <span aria-hidden="true">CYB<span class="dot"></span>RG</span>
  <span aria-hidden="true">JUNGLE</span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 0.28em;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
  }
  .wordmark > span { white-space: nowrap; }
  .small { font-size: var(--step-1); }
  .large { flex-direction: column; font-size: var(--step-4); }
  .dot {
    display: inline-block;
    width: 0.74em;
    height: 0.74em;
    margin: 0 0.03em;
    border-radius: 50%;
    background: var(--red);
    vertical-align: -0.04em;
  }
</style>
