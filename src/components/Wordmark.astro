---
// The Cyborg Jungle logo: plain white "Aliens Among Us" on black. No effects.
interface Props {
  size?: 'small' | 'large';
  tag?: 'span' | 'h1';
  /** Show the katakana name under the logo. */
  kana?: boolean;
}

const { size = 'small', tag: Tag = 'span', kana = false } = Astro.props;
---

<Tag class:list={['wordmark', size]}>
  {size === 'large' ? (
    <span class="logo"><span>Cyborg</span><span>Jungle</span></span>
  ) : (
    <span class="logo">Cyborg Jungle</span>
  )}
  {kana && <span class="kana" lang="ja">サイボーグ・ジャングル</span>}
</Tag>

<style>
  .wordmark { display: inline-grid; gap: 0.35em; margin: 0; color: #fff; }
  .logo {
    font-family: var(--font-logo);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 0.85;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .small .logo { font-size: 1.5rem; line-height: 1.15; }
  /* Two lines with clear air between them: this face's capitals fill 1.03em, so tight leading makes them collide */
  .large .logo { display: grid; font-size: clamp(3rem, 15vw, 8rem); line-height: 1.15; row-gap: 0.04em; white-space: nowrap; }
  .kana { font-family: var(--font-pixel); font-size: clamp(0.9rem, 4vw, 1.25rem); color: var(--mint); letter-spacing: 0.2em; }
</style>
