---
import { channels } from '../data/channels';

interface Props {
  active?: string;
}

const { active } = Astro.props;
---

<header class="hud" transition:name="hud" transition:animate="none">
  <div class="wrap hud-in">
    <a href="/" class="mark" aria-label="Cyborg Jungle — monitor wall">
      CYBORG<i>//</i>JUNGLE
    </a>
    <nav class="channels" aria-label="Channels">
      {channels.map((c) => (
        <a href={c.path} aria-current={active === c.id ? 'page' : undefined} aria-keyshortcuts={c.key} style={{ '--ch': c.color }}>
          <span class="num">{c.num}</span>
          <span class="lbl">{c.label}</span>
        </a>
      ))}
    </nav>
    <div class="status" aria-hidden="true">
      <span class="meter"><i></i><i></i><i></i><i></i><i></i></span>
      <span class="tc" data-tc>00:00:00:00</span>
    </div>
  </div>
  <div class="colour-burst" aria-hidden="true"></div>
</header>

<style>
  .hud {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(4 6 12 / 0.88);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }
  .hud-in {
    height: var(--hud-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: 0.12em;
    color: var(--ink);
    white-space: nowrap;
    text-shadow: -1.5px 0 rgb(255 0 80 / 0.55), 1.5px 0 rgb(0 220 255 / 0.55);
  }
  .mark i { font-style: normal; color: var(--phosphor); text-shadow: none; padding: 0 2px; }

  .channels { display: flex; gap: 4px; }
  .channels a {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 6px 14px;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--step--1);
    border: 1px solid transparent;
  }
  .channels a:hover { color: var(--ink); border-color: var(--line); }
  .num { font-family: var(--font-crt); font-size: var(--step-1); line-height: 1; color: var(--ch); }
  .channels a[aria-current='page'] {
    color: var(--ink);
    border-color: var(--ch);
    box-shadow: inset 0 0 18px color-mix(in srgb, var(--ch) 30%, transparent);
  }
  .channels a[aria-current='page'] .num { text-shadow: 0 0 10px color-mix(in srgb, var(--ch) 60%, transparent); }

  /* Colour burst: a thin test-card strip of the channel colours */
  .colour-burst {
    height: 2px;
    background: linear-gradient(to right,
      var(--ch-image) 0 18%, var(--ch-video) 0 41%, var(--ch-installation) 0 57%,
      var(--ch-about) 0 72%, var(--phosphor) 0 88%, var(--thermal) 0 94%, var(--signal) 0);
    opacity: 0.85;
  }

  .status { display: flex; align-items: center; gap: 12px; font-variant-numeric: tabular-nums; }
  .tc { font-family: var(--font-crt); font-size: var(--step-1); color: var(--glow); letter-spacing: 0.05em; min-width: 11ch; }
  .meter { display: flex; gap: 2px; align-items: flex-end; height: 14px; }
  .meter i { width: 3px; background: var(--phosphor); animation: meter 1.2s steps(3) infinite; }
  .meter i:nth-child(1) { height: 30%; }
  .meter i:nth-child(2) { height: 50%; animation-delay: -0.3s; }
  .meter i:nth-child(3) { height: 70%; animation-delay: -0.7s; }
  .meter i:nth-child(4) { height: 85%; animation-delay: -0.1s; }
  .meter i:nth-child(5) { height: 100%; animation-delay: -0.5s; }
  @keyframes meter { 50% { opacity: 0.25; } }

  /* Phones: channels become a four-button remote along the bottom */
  @media (max-width: 820px) {
    /* backdrop-filter would make the header the containing block for the fixed remote */
    .hud { backdrop-filter: none; background: rgb(4 6 12 / 0.96); }
    .channels {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 60;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      background: rgb(4 6 12 / 0.95);
      border-top: 1px solid var(--line);
      padding: 0 env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
    }
    .channels a {
      height: var(--remote-h);
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 0;
      font-size: 0.68rem;
      border-right: 1px solid var(--line);
    }
    .channels a:last-child { border-right: 0; }
    .num { font-size: var(--step-2); }
  }
  @media (max-width: 400px) {
    .meter { display: none; }
    .mark { font-size: var(--step-0); }
  }
</style>
