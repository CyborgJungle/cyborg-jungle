---
import Wordmark from './Wordmark.astro';
import { channels } from '../data/channels';

interface Props {
  active?: string;
}

const { active } = Astro.props;
---

<header class="site-header wrap">
  <a href="/" class="home" aria-label="Cyborg Jungle, home"><Wordmark /></a>
  <nav aria-label="Channels">
    <ul>
      {channels.map((c) => (
        <li>
          <a href={c.path} aria-current={active === c.id ? 'page' : undefined} style={{ '--ch': c.color }}>
            <span class="circled">{Number(c.num)}</span>
            <span class="name">{c.label}</span>
            <span class="jp" lang="ja">{c.jp}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: max(14px, env(safe-area-inset-top, 0px));
    padding-bottom: 12px;
  }
  .home { text-decoration: none; padding: 6px 0; }
  nav { width: 100%; }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: var(--stroke) solid var(--rule);
    border-bottom: var(--stroke) solid var(--rule);
  }
  li + li { border-left: var(--stroke) solid var(--rule); }
  a[href]:not(.home) {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 3px;
    min-height: 72px;
    padding: 8px 2px;
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
  }
  .circled { color: var(--ch); }
  .jp { font-family: var(--font-pixel); font-size: var(--step--2); color: var(--cream-soft); font-weight: 400; }
  a[aria-current='page'] { background: var(--ch); color: var(--void); }
  a[aria-current='page'] .circled { background: var(--void); border-color: var(--void); color: var(--ch); }
  a[aria-current='page'] .jp { color: var(--void); }

  @media (min-width: 820px) {
    nav { width: auto; }
    ul { border: 0; gap: 4px; }
    li + li { border-left: 0; }
    a[href]:not(.home) { grid-template-columns: auto auto; grid-template-rows: auto auto; column-gap: 8px; row-gap: 0; justify-items: start; min-height: 48px; padding: 6px 14px 6px 8px; border-radius: 999px; text-align: left; }
    .circled { grid-row: span 2; }
    a[href]:not(.home):not([aria-current]):hover { background: var(--panel); }
  }
</style>
