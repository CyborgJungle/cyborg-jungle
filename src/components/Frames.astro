---
// Slideshow frames stacked inside a TV screen. src/scripts/site.ts cuts between them every
// `interval` seconds while the screen is visible (paused with reduced motion).
import Img from './Img.astro';
import type { Img as ImgSrc } from '../lib/media';

interface Props {
  frames: ImgSrc[];
  alt: string;
  /** Seconds per frame. */
  interval: number;
  widths: number[];
  sizes: string;
  fit?: 'cover' | 'contain';
  eager?: boolean;
  /** Show at most this many frames, sampled evenly across the series (keeps the home page light). */
  max?: number;
  /** A video played as the last frame; the slideshow waits for it to end. */
  video?: { src: string; poster?: string };
}

const { frames: all, alt, interval, widths, sizes, fit = 'cover', eager = false, max, video } = Astro.props;
const frames =
  max && all.length > max ? Array.from({ length: max }, (_, k) => all[Math.round((k * (all.length - 1)) / (max - 1))]) : all;
---

<span class="frames" data-slideshow data-interval={Math.round(interval * 1000)} style={{ '--fit': fit }}>
  {frames.map((src, i) => (
    <span class="frame" data-frame data-active={i === 0 ? '' : undefined}>
      <Img src={src} alt={i === 0 ? alt : ''} widths={widths} sizes={sizes} loading={i === 0 && eager ? 'eager' : 'lazy'} />
    </span>
  ))}
  {video && (
    <span class="frame" data-frame>
      <video src={video.src} poster={video.poster} muted playsinline preload="none" aria-label={alt}></video>
    </span>
  )}
</span>

<style>
  .frames, .frame { position: absolute; inset: 0; display: block; }
  .frame { opacity: 0; }
  .frame[data-active] { opacity: 1; }
  .frame video { width: 100%; height: 100%; object-fit: var(--fit); display: block; background: var(--void); }
  .frame :global(img) { width: 100%; height: 100%; object-fit: var(--fit); display: block; background: var(--void); }
  /* Each cut lands with a short signal jolt: channels split, the picture slips sideways */
  .frames:global(.cut) .frame[data-active] :global(img) { animation: cut 0.18s steps(3) 1; }
  @keyframes cut {
    0% { filter: url(#rgb-split); transform: translateX(-8px); }
    50% { filter: url(#rgb-split); transform: translateX(5px); }
    100% { filter: none; transform: none; }
  }
</style>
