---
import Base from '../layouts/Base.astro';
import WorkTile from './WorkTile.astro';
import TestPattern from './TestPattern.astro';
import { channelFor, type ChannelId } from '../data/channels';
import { worksIn } from '../data/works';

interface Props {
  id: ChannelId;
}

const ch = channelFor(Astro.props.id);
const list = await worksIn(Astro.props.id);
---

<Base title={ch.label} description={`${ch.label} — ${ch.blurb}`} active={ch.id}>
  <section class="wrap" style={{ '--ch': ch.color }}>
    <header class="head">
      <span class="num" aria-hidden="true">{Number(ch.num)}</span>
      <div class="titles">
        <h1 class="glitch-type">{ch.label}</h1>
        <p>{ch.blurb}</p>
      </div>
      <span class="jp tategaki" lang="ja">{ch.jp}</span>
    </header>
    <div class="bar">
      <span class="label">{list.length} {list.length === 1 ? 'project' : 'projects'}</span>
    </div>

    {list.length > 0 ? (
      <div class="grid">
        {list.map((w) => <WorkTile work={w} />)}
      </div>
    ) : (
      <div class="empty">
        <div class="tv empty-screen">
          <TestPattern pattern="bars" seed={ch.id} label="Colour bars" />
        </div>
        <p><strong class="glitch-type">No signal yet.</strong> Something is being transmitted on this channel. It has not arrived. <span lang="ja" class="label">信号なし</span></p>
      </div>
    )}
  </section>
</Base>


<style>
  .head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'num titles jp';
    align-items: center;
    gap: 6px 16px;
    padding-block: 12px 18px;
  }
  .num {
    grid-area: num;
    display: grid;
    place-items: center;
    width: clamp(64px, 20vw, 120px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ch);
    color: var(--void);
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 11vw, 4.4rem);
    line-height: 1;
  }
  .titles { grid-area: titles; min-width: 0; }
  /* Scales with the screen so the longest channel name ("Interactive") fits beside the number */
  h1 { font-size: clamp(1.5rem, 7vw, 3rem); }
  .titles p { margin: 6px 0 0; color: var(--cream-soft); max-width: 46ch; }
  .jp { grid-area: jp; font-size: clamp(1.4rem, 6vw, 2.2rem); color: var(--ch); justify-self: center; }
  .bar { padding-bottom: 10px; border-bottom: var(--stroke) solid var(--rule); }


  .grid { margin-top: 20px; display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; } }

  .empty { margin-top: 24px; display: grid; gap: 16px; }
  .empty-screen { width: min(100%, 520px); aspect-ratio: 4 / 3; }
  .empty p { margin: 0; max-width: 42ch; color: var(--cream-soft); }
  .empty strong { color: var(--cream); font-family: var(--font-display); font-weight: 400; text-transform: uppercase; }
</style>
