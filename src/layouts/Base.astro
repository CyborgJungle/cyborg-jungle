---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  /** Channel id to mark as current in the menu. */
  active?: string;
  home?: boolean;
}

const { home = false, title, description = 'Cyborg Jungle — analog video art. Video broken through mixers and effect modules, filmed off a CRT.', active } = Astro.props;
const pageTitle = title ? `${title} — Cyborg Jungle` : 'Cyborg Jungle — Analog Video Art';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#efe9dc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <Header active={active} home={home} />
    <main id="main">
      <slot />
    </main>
    <footer class="wrap foot">
      <span class="dot" aria-hidden="true"></span>
      <span>© {new Date().getFullYear()} Cyborg Jungle</span>
      <span>Analog video art · Made with mixers, effect modules and a CRT</span>
    </footer>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  .skip:focus {
    position: fixed;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    z-index: 10;
    background: var(--ink);
    color: var(--paper);
    padding: 6px 12px;
  }
  main { padding-block: 24px 48px; }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    padding-top: 24px;
    padding-bottom: max(32px, env(safe-area-inset-bottom, 0px));
    border-top: var(--stroke) solid var(--ink);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .foot .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--red); }
</style>
